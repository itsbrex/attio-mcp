{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": "./src",
    "moduleResolution": "NodeNext",
    "baseUrl": "./src",
    "paths": {
      "@api/*": ["openai/api/*"],
      "@transform/*": ["openai/transform/*"],
      "@scoring/*": ["openai/scoring/*"],
      "@performance/*": ["openai/performance/*"],
      "@error/*": ["openai/error/*"],
      "@cache/*": ["openai/cache/*"],
      "*": ["./node_modules/@types/*"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "__tests__"]
}

