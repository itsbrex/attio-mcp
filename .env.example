# Attio MCP Server Environment Configuration

# =============================================================================
# AUTHENTICATION (choose one method)
# =============================================================================

# Option 1: API Key (recommended for long-term use)
# Get your API key from: https://app.attio.com/settings/api-keys
ATTIO_API_KEY=your_api_key_here
ATTIO_WORKSPACE_ID=your_workspace_id_here

# Optional: Test workspace toggle (prevents accidental changes to production)
# When ATTIO_USE_TEST_WORKSPACE=true, server uses ATTIO_TEST_API_KEY +
# ATTIO_TEST_WORKSPACE_ID instead. Case-insensitive. Defaults to false.
# ATTIO_USE_TEST_WORKSPACE=false
# ATTIO_TEST_API_KEY=your_test_api_key_here
# ATTIO_TEST_WORKSPACE_ID=your_test_workspace_id_here

# Option 2: OAuth Access Token (for OAuth integrations)
# Use this if you're authenticating via Attio OAuth instead of API keys.
# OAuth tokens work identically to API keys - both use Bearer authentication.
# See docs/guides/oauth-authentication.md for setup instructions.
# ATTIO_ACCESS_TOKEN=your_oauth_access_token_here

# Note: If both are set, ATTIO_API_KEY takes precedence.

# Optional: Server configuration
PORT=3000
LOG_LEVEL=info  # debug, info, warn, error
NODE_ENV=production

# E2E Test Configuration (recommended)
# Use a real, routable email domain for generated test users
# Many tenants validate email domains and reject non‑routable TLDs
E2E_TEST_EMAIL_DOMAIN=example.com
# Optional test data prefix for easier cleanup
E2E_TEST_PREFIX=E2E_TEST_
# Automatically clean up test data after E2E runs
E2E_CLEANUP_AFTER_TESTS=true
# Remote MCP testing (set only when targeting deployed endpoints)
# MCP_TEST_MODE=remote
# MCP_REMOTE_ENDPOINT=https://your-worker.workers.dev/mcp
# MCP_REMOTE_AUTH_TOKEN=<bearer_token_if_required>

# API Contract Modes (Optional - these are the defaults)
# Default: true (fail on violations)
E2E_API_CONTRACT_STRICT=true
# Default: false (strict mode), for debugging API issues temporarily set to true
E2E_API_CONTRACT_DEBUG=false

# Optional: Auto-Discovery Configuration
# Automatically discover and update attribute mappings
ATTIO_AUTO_DISCOVERY=
ATTIO_DISCOVERY_ON_STARTUP=
ATTIO_DISCOVERY_INTERVAL=

# SSE Transport Configuration (for Phase 1 testing)
ENABLE_SSE_TRANSPORT=
SSE_ENABLE_CORS=
SSE_HEARTBEAT_INTERVAL=
SSE_CONNECTION_TIMEOUT=
SSE_RATE_LIMIT_PER_MINUTE=
SSE_MAX_CONNECTIONS=
SSE_REQUIRE_AUTH=
SSE_ALLOWED_ORIGINS=

